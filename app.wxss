e-cover .route-tag{position:relative;z-index:1}.route-cover .source-badge{z-index:1}.route-cover.orange{background:radial-gradient(circle at 84% 19%,#fff5c6 0 9%,transparent 10%),linear-gradient(135deg,#ffe8a2,#f6b4bd)}.route-cover.blue{background:radial-gradient(circle at 83% 20%,#fff4bd 0 9%,transparent 10%),linear-gradient(135deg,#dcefc8,#a9c987)}.route-tag,.status-pill{display:inline-block;padding:6rpx 13rpx;border-radius:999rpx;background:rgba(255,253,247,.85);color:#5f7846;font-size:20rpx;font-weight:700}.source-badge{position:absolute;right:20rpx;bottom:18rpx;padding:5rpx 10rpx;border:1rpx solid rgba(91,119,70,.35);border-radius:999rpx;background:rgba(255,253,247,.84);color:#5d7747;font-size:19rpx;font-weight:800}.source-badge.community{border-color:#dfacb2;background:#fff2f0;color:#a9616b}.route-body{padding:22rpx}.route-title{font-size:32rpx;font-weight:800;letter-spacing:-1rpx;line-height:1.35}.route-desc{margin-top:8rpx;color:#775f4c;font-size:24rpx;line-height:1.65}.facts{margin-top:14rpx;color:#775f4c;font-size:21rpx;line-height:1.6}.primary-btn,.secondary-btn{display:flex;min-height:88rpx;align-items:center;justify-content:center;border-radius:22rpx;font-size:29rpx;font-weight:800}.primary-btn{background:#a9c987;color:#423328;box-shadow:0 10rpx 18rpx rgba(116,153,72,.22)}.secondary-btn{border:2rpx solid #e8cfaf;background:#fffdf7;color:#5f7846}.empty{padding:55rpx 24rpx;border-radius:28rpx;background:#f4edcf;color:#775f4c;text-align:center;font-size:25rpx;line-height:1.7}.chip-row{display:flex;gap:12rpx;overflow-x:auto;padding:20rpx 0 24rpx;white-space:nowrap}.chip{display:inline-flex;min-height:58rpx;align-items:center;padding:0 20rpx;border:2rpx solid #e8cfaf;border-radius:999rpx;color:#775f4c;font-size:23rpx}.chip.active{border-color:#423328;background:#423328;color:#fff}.form-card{margin-top:20rpx;padding:26rpx;border:2rpx solid #ead5af;border-radius:28rpx;background:#fffdf7}.form-title{font-size:30rpx;font-weight:800}.form-help{margin:6rpx 0 18rpx;color:#775f4c;font-size:23rpx;line-height:1.6}.field-label{display:block;margin-top:20rpx;color:#5d4b3b;font-size:23rpx;font-weight:800}.field-input,.field-textarea{box-sizing:border-box;width:100%;margin-top:10rpx;padding:19rpx;border:2rpx solid #e8cfaf;border-radius:20rpx;background:#fffdf7;color:#423328;font-size:27rpx}.field-textarea{min-height:150rpx}.option-row{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding:21rpx;border:2rpx solid #e8cfaf;border-radius:22rpx}.option-row.selected{border-color:#a9c987;background:#f3f8df}.option-title{font-size:27rpx;font-weight:800}.option-sub{display:block;margin-top:4rpx;color:#775f4c;font-size:21rpx}.back{width:60rpx;height:60rpx;border-radius:18rpx;background:#f4edcf;color:#775f4c;font-size:36rpx}.detail-top{display:flex;align-items:center;gap:18rpx;padding:18rpx 0}.detail-title{font-family:Georgia,"Songti SC",serif;font-size:36rpx;font-weight:800}.hero-panel{position:relative;overflow:hidden;padding:34rpx;border-radius:34rpx;background:radial-gradient(circle at 87% 18%,rgba(255,246,185,.88) 0 12%,transparent 13%),linear-gradient(135deg,#a9c987,#c9df91 65%,#f7d464)}.hero-panel h1{margin:18rpx 0 12rpx;font-family:Georgia,"Songti SC",serif;font-size:48rpx;letter-spacing:-3rpx;line-height:1.2}.hero-panel p{margin:0;color:#5f6043;font-size:25rpx;line-height:1.7}.sticky-action{position:fixed;right:0;bottom:calc(126rpx + env(safe-area-inset-bottom));left:0;z-index:3;padding:18rpx 32rpx;background:rgba(255,250,240,.94)}.two-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.loading{padding:100rpx 0;color:#a5844d;text-align:center}.avatar{display:flex;width:86rpx;height:86rpx;align-items:center;justify-content:center;border-radius:28rpx;background:linear-gradient(145deg,#f7d464,#f6b4bd);box-shadow:5rpx 6rpx 0 #e8cfaf;color:#423328;font-family:Georgia,"Songti SC",serif;font-size:38rpx;font-weight:800}.divider{height:1rpx;margin:28rpx 0;background:#ead5af}.modal-mask{position:fixed;i