.tabbar{position:fixed;right:0;bottom:0;left:0;z-index:99;display:flex;align-items:flex-start;justify-content:space-around;height:112rpx;padding:12rpx 9rpx calc(14rpx + env(safe-area-inset-bottom));box-sizing:content-box;border-top:1rpx solid #e8cfaf;background:rgba(255,253,247,.97);box-shadow:0 -7rpx 22rpx rgba(125,96,55,.08)}.tab{display:flex;flex:1;flex-direction:column;align-items:center;gap:4rpx;min-width:0;color:#92755a;font-size:18rpx;line-height:1.2}.tab-icon-wrap{display:grid;width:45rpx;height:43rpx;place-items:center}.tab-icon{font-size:32rpx;font-weight:400;line-height:1}.tab-text{font-size:18rpx}.selected{color:#5d7c48;font-weight:700}.tab-primary{margin-top:-21rpx}.tab-primary .tab-icon-wrap{width:72rpx;height:72rpx;border:5rpx solid #fffaf0;border-radius:28rpx;background:#f6b4bd;box-shadow:0 10rpx 20rpx rgba(202,131,142,.28);color:#423328}.tab-primary .tab-icon{font-size:43rpx;font-weight:300}.tab-primary .tab-text{margin-top:2rpx;color:#775f4c;font-weight:700}