.chat-list{padding-bottom:120rpx}.chat-message{margin:22rpx 0}.chat-name{margin-bottom:7rpx;color:#92755a;font-size:20rpx}.chat-bubble{display:inline-block;max-width:80%;padding:18rpx 21rpx;border-radius:8rpx 24rpx 24rpx;background:#fffdf7;box-shadow:0 5rpx 14rpx rgba(125,96,55,.09);font-size:26rpx;line-height:1.6}.chat-time{margin-top:6rpx;color:#a5844d;font-size:18rpx}.composer{position:fixed;right:0;bottom:0;left:0;z-index:4;display:flex;gap:12rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e8cfaf;background:#fffdf7}.composer input{flex:1;min-width:0;padding:16rpx 19rpx;border:2rpx solid #e8cfaf;border-radius:22rpx;background:#fffaf0;font-size:25rpx}.composer button{padding:0 20rpx;border-radius:20rpx;background:#a9c987;font-size:25rpx;font-weight:800}.sheet-btn{width:100%;margin-top:20rpx}