.home-page{padding-top:0}.weekend-cover{position:relative;min-height:450rpx;margin:0 -32rpx 0;padding-right:42rpx;padding-bottom:50rpx;padding-left:42rpx;overflow:hidden;border-radius:0 0 46rpx 46rpx;background:#36764b}.hero-photo{position:absolute;inset:0;width:100%;height:100%;transform:scale(1.04);animation:hero-breathe 12s ease-in-out infinite alternate}.hero-photo-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,45,31,.83) 0%,rgba(19,73,42,.64) 48%,rgba(15,72,42,.18) 100%),linear-gradient(0deg,rgba(8,43,29,.48),transparent 56%)}.hero-aurora{position:absolute;right:-96rpx;top:104rpx;width:360rpx;height:230rpx;border-radius:50%;background:radial-gradient(ellipse,rgba(246,255,145,.46) 0%,rgba(170,241,113,.18) 36%,transparent 68%);filter:blur(8rpx);animation:aurora-drift 8s ease-in-out infinite}.cover-copy{position:relative;z-index:4;width:68%}.cover-brand-row{display:flex;align-items:center;gap:18rpx}.cover-copy .brand{font-family:Georgia,"Songti SC",serif;font-size:50rpx;font-weight:900;letter-spacing:-3rpx;color:#fffdf0;text-shadow:0 4rpx 12rpx rgba(8,42,27,.25)}.cover-city{padding-left:18rpx;border-left:2rpx solid rgba(255,255,239,.44);color:#fff9d9;font-size:27rpx;font-weight:700}.cover-copy .eyebrow{margin-top:11rpx;color:#d8f18e;font-size:17rpx;letter-spacing:2rpx}.cover-title{margin:22rpx 0 12rpx;font-family:Georgia,"Songti SC",serif;font-size:56rpx;font-weight:800;letter-spacing:-4rpx;line-height:1.05;color:#fffdf1;text-shadow:0 5rpx 16rpx rgba(8,38,25,.3)}.cover-text{color:rgba(248,255,232,.86);font-size:23rpx;line-height:1.7}.orbit-emblem{position:absolute;right:38rpx;bottom:40rpx;z-index:3;width:150rpx;height:150rpx}.emblem-planet{position:absolute;right:18rpx;bottom:12rpx;width:88rpx;height:88rpx;border:5rpx solid rgba(255,255,230,.72);border-radius:50%;background:radial-gradient(circle at 35% 27%,#fff5a9 0 8%,#eff469 9% 28%,#73c260 29% 66%,#297a4d 67%);box-shadow:inset -9rpx -10rpx 0 rgba(17,91,48,.18),0 13rpx 26rpx rgba(3,36,20,.28);animation:planet-float 5.5s ease-in-out infinite}.emblem-ring{position:absolute;right:0;bottom:34rpx;width:142rpx;height:50rpx;border:4rpx solid rgba(255,255,231,.84);border-left-color:transparent;border-radius:50%;transform:rotate(-19deg);animation:ring-glide 9s linear infinite}.emblem-star{position:absolute;color:#fff7a7;font-size:28rpx;line-height:1;text-shadow:0 2rpx 9rpx rgba(255,250,159,.7);animation:star-twinkle 2.8s ease-in-out infinite}.star-one{right:112rpx;bottom:101rpx}.star-two{right:5rpx;bottom:116rpx;font-size:18rpx;animation-delay:1.1s}.hero-petal{position:absolute;z-index:3;width:13rpx;height:21rpx;border-radius:80% 20% 80% 20%;background:rgba(255,243,178,.92);box-shadow:0 3rpx 8rpx rgba(13,57,34,.2)}.petal-one{right:165rpx;bottom:169rpx;animation:petal-float 6s linear infinite}.petal-two{right:66rpx;bottom:185rpx;width:10rpx;height:16rpx;background:#f8cdd6;animation:petal-float 7s linear 1.8s infinite}.petal-three{right:203rpx;bottom:87rpx;width:9rpx;height:15rpx;background:#d5ef8c;animation:petal-float 6.4s linear .8s infinite}.top-actions{position:relative;z-index:5;display:grid;grid-template-columns:154rpx 1fr;gap:16rpx;margin:-30rpx 18rpx 0}.top-search,.top-community{display:flex;min-height:88rpx;align-items:center;justify-content:center;border-radius:24rpx;font-size:25rpx;font-weight:800;box-shadow:0 12rpx 24rpx rgba(22,58,34,.16)}.top-search{background:#fffdf7;color:#273227}.top-search text{margin-right:8rpx;font-size:35rpx;line-height:1}.top-community{background:linear-gradient(100deg,#ffe24f,#c8ee5f);color:#263322}.top-community text{margin-right:8rpx;font-size:31rpx}.top-plan{margin-right:0;margin-left:0}.home-prompt{display:block;width:100%;margin:30rpx 0 42rpx;padding:25rpx 28rpx;border-radius:28rpx;background:linear-gradient(130deg,#fff3b7,#f8d86c);box-shadow:5rpx 6rpx 0 #e8cfaf;text-align:left}.home-prompt text,.home-prompt b{display:block}.home-prompt text{color:#775f4c;font-size:22rpx}.home-prompt b{margin-top:7rpx;font-size:30rpx}.mood-section{padding-bottom:32rpx;border-bottom:2rpx dashed #e1c99d}.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:13rpx}.moods button{min-height:130rpx;padding:14rpx 6rpx;border:2rpx solid #ead5af;border-radius:22rpx;background:#fffdf7;color:#5d4b3b;font-size:20rpx;line-height:1.35}.moods text{display:block;margin-bottom:7rpx;font-size:38rpx}.home-invite{display:flex;gap:20rpx;padding:24rpx;text-align:left}.home-invite b,.home-invite text{display:block}.home-invite b{margin-top:8rpx;font-size:29rpx}.home-invite text{margin-top:6rpx;color:#775f4c;font-size:22rpx}.record-card{display:block;width:100%;margin-top:40rpx;padding:28rpx;border-radius:28rpx;background:linear-gradient(135deg,#fff2bd,#f7dfe1);text-align:left}.record-card text,.record-card b,.record-card view{display:block}.record-card text{color:#a5844d;font-size:18rpx;font-weight:800;letter-spacing:2rpx}.record-card b{margin:10rpx 0;color:#423328;font-size:29rpx;line-height:1.55}.record-card view{color:#775f4c;font-size:22rpx}.home-visual{background:#476f51}.home-visual::after{display:none}.home-visual .route-tag,.home-visual .source-badge{position:relative;z-index:1}@keyframes hero-breathe{from{transform:scale(1.04) translate3d(0,0,0)}to{transform:scale(1.11) translate3d(-8rpx,-6rpx,0)}}@keyframes aurora-drift{0%,100%{transform:translate(0,0);opacity:.58}50%{transform:translate(-32rpx,19rpx);opacity:1}}@keyframes planet-float{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-11rpx) rotate(8deg)}}@keyframes ring-glide{to{transform:rotate(341deg)}}@keyframes star-twinkle{0%,100%{transform:scale(.72);opacity:.45}50%{transform:scale(1.15);opacity:1}}@keyframes petal-float{0%{transform:translate(0,0) rotate(0);opacity:0}15%{opacity:1}85%{opacity:1}100%{transform:translate(-58rpx,94rpx) rotate(225deg);opacity:0}}@media (prefers-reduced-motion:reduce){.hero-photo,.hero-aurora,.emblem-planet,.emblem-ring,.emblem-star,.hero-petal{animation:none}}