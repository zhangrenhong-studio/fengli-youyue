.invite-card{margin-bottom:20rpx;padding:26rpx}.invite-top,.invite-actions{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.invite-title{margin:16rpx 0 9rpx;font-size:31rpx;font-weight:800;line-height:1.4}.invite-copy,.invite-note{color:#775f4c;font-size:23rpx;line-height:1.75}.invite-note{margin-top:12rpx;color:#5d4b3b}.invite-actions{margin-top:22rpx}.invite-actions button{flex:1;min-height:75rpx;font-size:24rpx}.leave-btn{display:block;margin:18rpx auto 0;color:#92755a;font-size:21rpx}