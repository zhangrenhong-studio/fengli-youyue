.profile-hero{display:grid;grid-template-columns:86rpx minmax(0,1fr) auto;gap:18rpx;align-items:center;padding:20rpx 0}.profile-hero .avatar image,.avatar-picker image{width:100%;height:100%;border-radius:inherit}.profile-name{font-size:35rpx;font-weight:800}.profile-meta,.profile-bio{margin-top:4rpx;color:#775f4c;font-size:22rpx;line-height:1.5}.profile-edit{padding:10rpx;color:#5f7846;font-size:22rpx}.profile-counts{display:grid;grid-template-columns:repeat(3,1fr);padding:22rpx 0;border-top:2rpx solid #ead5af;border-bottom:2rpx solid #ead5af}.profile-counts view{text-align:center}.profile-counts b,.profile-counts text{display:block}.profile-counts b{font-size:31rpx}.profile-counts text{color:#92755a;font-size:19rpx}.plan-card,.mini-invite{display:block;box-sizing:border-box;width:100%;margin-bottom:14rpx;padding:24rpx;text-align:left}.plan-title{margin-top:13rpx;font-size:29rpx;font-weight:800}.mini-invite b,.mini-invite text{display:block}.mini-invite text{margin-top:8rpx;color:#775f4c;font-size:22rpx}.avatar-picker{display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#775f4c;font-size:21rpx}.avatar-picker image,.avatar-picker>text:first-child{display:grid;width:110rpx;height:110rpx;place-items:center;border-radius:34rpx;background:linear-gradient(145deg,#f7d464,#f6b4bd);font-size:46rpx}.short{min-height:110rpx}.photo-btn{width:100%;margin:24rpx 0 10rpx}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.photo-cell{position:relative;overflow:hidden;aspect-ratio:1;border-radius:16rpx}.photo-cell image{width:100%;height:100%}.photo-cell button{position:absolute;right:4rpx;top:4rpx;width:38rpx;height:38rpx;border-radius:50%;background:rgba(66,51,40,.66);color:#fff}.profile-save{margin-top:28rpx}.profile-save button{min-height:82rpx;font-size:26rpx}