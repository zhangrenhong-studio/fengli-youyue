/* Premium HIG material layer — brand expression without compromising hierarchy or controls. */
.page.home-page{background:linear-gradient(160deg,#e9f5ff 0,#f2f2f7 34%,#f2f2f7 100%)}.home-page .editorial-intro{padding-top:34rpx}.home-page .editorial-kicker{color:#5d7296;font-size:23rpx;font-weight:600}.home-page .editorial-title{font-size:60rpx;letter-spacing:-3rpx}.home-page .editorial-title text{background:linear-gradient(100deg,#1c315d,#377eff);background-clip:text;color:transparent}.home-page .date-pill{border:1rpx solid #dce1eb;background:#ffffff9a;box-shadow:0 3rpx 8rpx rgba(24,43,83,.04)}.home-page .date-pill.active{border-color:transparent;background:#182b53}.home-page .editorial-route{height:520rpx;border-radius:26rpx;box-shadow:0 18rpx 32rpx rgba(21,42,92,.22)}.home-page .route-overlay{right:28rpx;bottom:28rpx;left:28rpx}.home-page .route-heading{font-size:49rpx}.home-page .route-facts{border:1rpx solid #e0e4ed;box-shadow:0 6rpx 18rpx rgba(35,56,93,.05)}.home-page .home-next-plan{position:relative;overflow:hidden;border-radius:20rpx;background:linear-gradient(120deg,#172e5a,#2257a9);color:#fff;box-shadow:0 14rpx 25rpx rgba(30,67,130,.2)}.home-page .home-next-plan:after{position:absolute;right:-38rpx;bottom:-54rpx;width:190rpx;height:190rpx;content:"";border:1rpx solid rgba(255,255,255,.22);border-radius:50%;box-shadow:0 0 0 30rpx rgba(255,255,255,.06),0 0 0 65rpx rgba(255,255,255,.04)}.home-page .home-next-plan>view{position:relative;z-index:1}.home-page .home-state-label,.home-page .home-next-main text,.home-page .home-next-note{color:#c8ddff}.home-page .home-next-main b{color:#fff}.home-page .home-next-arrow{display:grid;width:56rpx;height:56rpx;place-items:center;border-radius:50%;background:#fff;color:#1b4eac}.home-page .quiet-ai,.home-page .home-record-entry{border:1rpx solid rgba(255,255,255,.8);background:rgba(255,255,255,.68);box-shadow:0 10rpx 24rpx rgba(33,58,109,.06);backdrop-filter:blur(12rpx)}.home-page .alternative-card{border:1rpx solid rgba(255,255,255,.8);background:linear-gradient(145deg,#e8f4ff,#fff);box-shadow:0 10rpx 22rpx rgba(33,58,109,.05)}.home-page .alternative-card:nth-child(2){background:linear-gradient(145deg,#f2f2ff,#fff)}.home-page .editorial-invite{box-shadow:0 9rpx 22rpx rgba(33,58,109,.06)}.profile-avatar{box-shadow:0 6rpx 16rpx rgba(36,107,254,.18)}.editorial-submit,.invite-primary-button,.editorial-adopt-button,.plan-card button,.plan-actions button{background:linear-gradient(110deg,#246bfe,#347dff)}.detail-hero{background:linear-gradient(145deg,#0e1b38,#1f4d9d)!important}.detail-page .detail-stats>view{background:rgba(255,255,255,.14)}.create-mode-card.chosen{background:linear-gradient(145deg,#eaf4ff,#fff);box-shadow:0 9rpx 20rpx rgba(36,107,254,.09)}.invite-card-v2,.detail-invite-card{box-shadow:0 8rpx 18rpx rgba(33,58,109,.05)}
