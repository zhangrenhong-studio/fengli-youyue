/* Motion respects the action hierarchy: one quiet scene layer and short entrance transitions. */
.home-motion-enter{animation:flow-rise 520ms cubic-bezier(.2,.8,.2,1) both}.home-motion-delay-one{animation-delay:90ms}.home-motion-delay-two{animation-delay:170ms}.home-plan-aurora{position:absolute;z-index:0;border-radius:50%;background:radial-gradient(circle,rgba(161,218,255,.42),rgba(161,218,255,0) 68%);pointer-events:none}.aurora-one{right:-28rpx;top:-42rpx;width:310rpx;height:310rpx;animation:aurora-drift 7s ease-in-out infinite}.aurora-two{bottom:-150rpx;left:90rpx;width:360rpx;height:360rpx;background:radial-gradient(circle,rgba(112,159,255,.25),rgba(112,159,255,0) 70%);animation:aurora-drift 9s ease-in-out infinite reverse}.home-primary-plan>view:not(.home-plan-aurora){position:relative;z-index:2}.home-featured-image{animation:route-breathe 15s ease-in-out infinite}.home-route-light{position:absolute;z-index:1;top:-45%;left:-25%;width:42%;height:190%;transform:rotate(18deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.20),transparent);animation:route-light 8s ease-in-out infinite;pointer-events:none}.home-decision{transition:transform 170ms ease,box-shadow 170ms ease}.home-decision:active{transform:scale(.975);box-shadow:0 5rpx 12rpx rgba(29,56,102,.08)}.home-featured-route:active{transform:scale(.985)}.home-companion{transition:transform 170ms ease}.home-companion:active{transform:scale(.985)}@keyframes flow-rise{from{opacity:0;transform:translateY(22rpx)}to{opacity:1;transform:translateY(0)}}@keyframes aurora-drift{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(-18rpx,14rpx,0) scale(1.12)}}@keyframes route-breathe{0%,100%{transform:scale(1.02)}50%{transform:scale(1.08)}}@keyframes route-light{0%,58%,100%{transform:translateX(-460rpx) rotate(18deg);opacity:0}66%{opacity:.8}83%{transform:translateX(960rpx) rotate(18deg);opacity:0}}
