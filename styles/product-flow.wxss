/* Product-flow layout: each screen has one decision, aligned with WeChat mini-program navigation. */
.home-page{background:linear-gradient(160deg,#eaf4ff 0,#f5f7fb 34%,#f5f7fb 100%)}.home-topbar{margin-bottom:0}.home-welcome{padding:50rpx 4rpx 24rpx}.home-welcome-kicker{color:#63718a;font-size:23rpx;font-weight:600}.home-welcome-title{margin-top:12rpx;font-size:59rpx;font-weight:750;line-height:1.13;letter-spacing:-3rpx}.home-welcome-title text{color:#246bfd}.home-welcome-copy{margin-top:15rpx;color:#63718a;font-size:24rpx;line-height:1.6}.home-primary-plan{position:relative;overflow:hidden;margin-top:40rpx;padding:34rpx;border-radius:24rpx;background:linear-gradient(137deg,#132c5c,#2668ce);color:#fff;box-shadow:0 16rpx 32rpx rgba(28,77,159,.25)}.home-primary-plan:after{position:absolute;right:-45rpx;bottom:-67rpx;width:200rpx;height:200rpx;content:"";border:1rpx solid rgba(255,255,255,.24);border-radius:50%;box-shadow:0 0 0 32rpx rgba(255,255,255,.07),0 0 0 68rpx rgba(255,255,255,.04)}.home-primary-plan>view{position:relative;z-index:1}.home-primary-state{color:#bdd8ff;font-size:21rpx}.home-primary-title{max-width:490rpx;margin:12rpx 0 9rpx;font-size:37rpx;font-weight:700;line-height:1.3}.home-primary-meta{max-width:470rpx;color:#dce9ff;font-size:23rpx;line-height:1.55}.home-primary-action{display:inline-block;margin-top:21rpx;padding:13rpx 17rpx;border-radius:12rpx;background:#fff;color:#1d58ba;font-size:23rpx;font-weight:700}.home-decision-row{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:31rpx}.home-decision{position:relative;min-height:226rpx;padding:24rpx;border:1rpx solid #fff;border-radius:20rpx;background:#fff;box-shadow:0 10rpx 22rpx rgba(29,56,102,.07)}.home-decision.ai{background:linear-gradient(145deg,#edf4ff,#fff)}.home-decision-icon{display:grid;width:56rpx;height:56rpx;place-items:center;border-radius:16rpx;background:#dceaff;color:#246bfd;font-size:28rpx}.home-decision-icon.explore{background:#edf0f5;color:#51627d}.home-decision b,.home-decision text{display:block}.home-decision b{margin-top:20rpx;font-size:27rpx}.home-decision text{margin-top:7rpx;color:#73809a;font-size:20rpx;line-height:1.45}.home-decision-arrow{position:absolute;right:21rpx;bottom:17rpx;color:#246bfd;font-size:32rpx}.home-section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:49rpx 4rpx 16rpx}.home-section-head>view:first-child text,.home-section-head>view:first-child b{display:block}.home-section-head>view:first-child text{font-size:32rpx;font-weight:700;letter-spacing:-1rpx}.home-section-head>view:first-child b{margin-top:6rpx;color:#73809a;font-size:20rpx;font-weight:400}.home-featured-route{position:relative;overflow:hidden;height:470rpx;border-radius:22rpx;background:#172b4d;box-shadow:0 12rpx 28rpx rgba(29,56,102,.13)}.home-featured-route image,.home-featured-shade{position:absolute;inset:0;width:100%;height:100%}.home-featured-shade{background:linear-gradient(180deg,transparent 31%,rgba(7,15,31,.82))}.home-featured-copy{position:absolute;z-index:2;right:28rpx;bottom:28rpx;left:28rpx;color:#fff}.home-featured-copy text{color:#c5dbff;font-size:20rpx}.home-featured-copy b{display:block;margin:8rpx 0;font-size:37rpx;line-height:1.23}.home-featured-copy view{color:#dce7fb;font-size:21rpx}.home-empty-route{padding:35rpx;border-radius:18rpx;background:#fff;color:#73809a;text-align:center}.home-companion{display:flex;align-items:center;gap:19rpx;padding:24rpx;border-radius:18rpx;background:#fff;box-shadow:0 9rpx 21rpx rgba(29,56,102,.06)}.home-companion-dot{display:grid;flex:0 0 auto;width:58rpx;height:58rpx;place-items:center;border-radius:17rpx;background:#e8f7f0;color:#2e9b6e;font-size:27rpx}.home-companion>view:nth-child(2){flex:1;min-width:0}.home-companion text,.home-companion b{display:block}.home-companion text{color:#2e9b6e;font-size:19rpx}.home-companion b{overflow:hidden;margin:6rpx 0;color:#16233a;font-size:26rpx;white-space:nowrap;text-overflow:ellipsis}.home-companion>view:nth-child(2)>view{color:#73809a;font-size:20rpx}.home-companion-arrow{color:#246bfd;font-size:35rpx}.home-companion-empty .home-companion-dot{background:#eaf2ff;color:#246bfd}.home-companion-empty b{white-space:normal}.home-record{display:flex;justify-content:space-between;gap:20rpx;margin-top:42rpx;padding:25rpx 4rpx;border-top:1rpx solid #e0e5ee}.home-record text,.home-record b,.home-record view{display:block}.home-record text{color:#73809a;font-size:20rpx}.home-record b{overflow:hidden;max-width:520rpx;margin-top:8rpx;font-size:25rpx;white-space:nowrap;text-overflow:ellipsis}.home-record view{margin-top:9rpx;color:#246bfd;font-size:21rpx}.home-record-empty b{color:#46536b;font-weight:500}
/* Object-specific screens: a route gets adopted, a plan gets executed, an invitation gets assessed. */
.discover-editorial .page-intro,.create-editorial .page-intro{padding-bottom:29rpx}.discover-editorial .editorial-switcher{display:flex;gap:10rpx;margin-bottom:23rpx;overflow:auto}.discover-editorial .editorial-switch{flex:0 0 auto;padding:13rpx 17rpx;border-radius:999rpx;background:#e8ebf1;color:#627089;font-size:22rpx}.discover-editorial .editorial-switch.on{background:#246bfd;color:#fff}.discover-editorial .editorial-create{flex:0 0 auto;padding:13rpx 17rpx;border-radius:999rpx;background:#eaf2ff;color:#246bfd;font-size:22rpx}.route-editorial-card{margin-bottom:16rpx;padding:26rpx;border-radius:19rpx;background:#fff;box-shadow:0 8rpx 19rpx rgba(29,56,102,.05)}.route-card-label{display:flex;justify-content:space-between;color:#73809a;font-size:19rpx}.route-editorial-card h3{margin:15rpx 0 9rpx;font-size:33rpx;letter-spacing:-1rpx}.route-editorial-card p{display:-webkit-box;overflow:hidden;margin:0;color:#73809a;font-size:22rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.route-card-facts{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:17rpx}.route-card-facts text{padding:8rpx 11rpx;border-radius:999rpx;background:#f0f3f7;color:#59677d;font-size:19rpx}.route-card-link{margin-top:19rpx;color:#246bfd;font-size:22rpx;font-weight:600}.create-mode{margin-top:0}.create-mode-card{min-height:166rpx}.create-mode-card.chosen{outline:2rpx solid #246bfd}.detail-page .timeline{padding-top:30rpx}.detail-page .adopt-card{box-shadow:0 9rpx 20rpx rgba(29,56,102,.05)}.plan-detail .page-intro p{margin:11rpx 0 0;color:#73809a;font-size:23rpx}.plan-detail .plan-card{box-shadow:0 9rpx 20rpx rgba(29,56,102,.05)}.invitations-editorial .invite-page-heading{padding-top:34rpx}.invite-card-v2{box-shadow:0 9rpx 20rpx rgba(29,56,102,.05)}
